GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local dev skips Turnstile; set to true to test the real challenge (use Cloudflare test keys)
TURNSTILE_ENFORCE_IN_DEV=false
# Upstash Redis (rate limiting). Leave empty to disable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Supabase (chat logs). Leave empty to disable. Use the service role key; keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Set to true (and redeploy) to disable the chat API
MAINTENANCE_MODE=false
